# ─── PostgreSQL ──────────────────────────────────────────────────────────────
POSTGRES_USER=ecom
POSTGRES_PASSWORD=ecom123

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_PASSWORD=redis123

# ─── Kafka ───────────────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# ─── JWT ─────────────────────────────────────────────────────────────────────
# openssl rand -base64 32 để generate secret
JWT_SECRET=your-256-bit-secret-key-change-in-production-please
JWT_ACCESS_TOKEN_EXPIRY=900000       # 15 minutes (ms)
JWT_REFRESH_TOKEN_EXPIRY=604800000   # 7 days (ms)

# ─── Services ────────────────────────────────────────────────────────────────
USER_SERVICE_URL=http://localhost:8081
PRODUCT_SERVICE_URL=http://localhost:8082
ORDER_SERVICE_URL=http://localhost:8083
NOTIFICATION_SERVICE_URL=http://localhost:8084

# ─── Rate limiting ────────────────────────────────────────────────────────────
RATE_LIMIT_CAPACITY=60
RATE_LIMIT_REFILL=60
